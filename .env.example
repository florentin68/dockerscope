# Configuration du backend
PORT=3001
NODE_ENV=production

# Authentification Docker Hub (optionnel)
# Pour éviter les limites de rate (100 requêtes/6h)
# Utilisez le nom d'utilisateur avec un mot de passe ou un token personnel
DOCKERHUB_USERNAME=votre_username_dockerhub
DOCKERHUB_PASSWORD=votre_mot_de_passe
# OU
DOCKERHUB_TOKEN=votre_token_personnel

# Tokens pour autres registries (optionnels - pour les images privées)
# GitHub Container Registry (ghcr.io)
GITHUB_TOKEN=votre_token_github

# GitLab Container Registry (registry.gitlab.com)
GITLAB_TOKEN=votre_token_gitlab

# Quay.io
QUAY_TOKEN=votre_token_quay

# Notifications (optionnelles)
# Telegram
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# Gotify
GOTIFY_URL=https://gotify.example.com
GOTIFY_TOKEN=AbCdEfGhIjKlMnOp

# Configuration Portainer (optionnel)
# Pour gérer les mises à jour via l'API Portainer
PORTAINER_URL=https://portainer.votre-domaine.com
PORTAINER_API_KEY=votre_clé_api_portainer
PORTAINER_ENDPOINT_ID=1
